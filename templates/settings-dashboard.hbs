<div class="nd5t-dashboard-wrapper">
    {{!-- Top Toolbar / Search Bar --}}
    <header class="nd5t-dashboard-header">
        <div class="nd5t-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="nd5t-search-input" placeholder="Search tweaks &amp; settings... (e.g. initiative, damage, concentration)" autocomplete="off" spellcheck="false">
            <button type="button" class="nd5t-search-clear" title="Clear Search" style="display: none;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="nd5t-search-status" style="display: none;">
            <span class="nd5t-match-count">0</span> matches found
        </div>
    </header>

    {{!-- Main Body with Sidebar Tabs and Content --}}
    <div class="nd5t-dashboard-body">
        {{!-- Navigation Tabs --}}
        <nav class="nd5t-nav-tabs" aria-label="Settings Categories">
            {{#each tabs}}
            <button type="button" class="nd5t-nav-tab {{#if this.active}}active{{/if}}" data-tab="{{this.id}}">
                <i class="{{this.icon}}"></i>
                <span class="tab-label">{{this.label}}</span>
                <span class="tab-badge" data-tab-matches="{{this.id}}" style="display: none;">0</span>
            </button>
            {{/each}}
        </nav>

        {{!-- Settings Content Panels --}}
        <div class="nd5t-settings-content standard-form">
            {{#each tabs}}
            <section class="nd5t-tab-panel {{#if this.active}}active{{/if}}" data-tab="{{this.id}}">
                <div class="nd5t-tab-header">
                    <h2><i class="{{this.icon}}"></i> {{this.label}}</h2>
                    {{#if this.description}}
                    <p class="nd5t-tab-desc">{{this.description}}</p>
                    {{/if}}
                </div>

                {{#each this.sections}}
                <div class="nd5t-section" data-section="{{this.id}}">
                    {{#if this.title}}
                    <h3 class="nd5t-section-title">
                        {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                        <span>{{this.title}}</span>
                    </h3>
                    {{/if}}

                    <div class="nd5t-settings-list">
                        {{#each this.settings}}
                        <div class="nd5t-setting-row {{#if this.isChild}}nd5t-child-setting{{/if}} {{#if this.v14Only}}nd5t-v14-only{{/if}}" 
                             data-key="{{this.key}}" 
                             {{#if this.parentKey}}data-parent="{{this.parentKey}}"{{/if}}
                             data-search-text="{{this.searchText}}">
                            
                            <div class="nd5t-setting-info">
                                <div class="nd5t-setting-title-row">
                                    {{#if this.isChild}}<span class="nd5t-tree-branch">↳</span>{{/if}}
                                    <label class="nd5t-setting-name" for="nd5t-setting-{{this.key}}">{{this.name}}</label>
                                    
                                    {{!-- Badges --}}
                                    <div class="nd5t-badges">
                                        {{#if this.isUser}}
                                        <span class="nd5t-badge user" title="This setting is stored per user account — each user configures it independently">User</span>
                                        {{else if this.isClient}}
                                        <span class="nd5t-badge client" title="This setting is stored locally per client/user">Client</span>
                                        {{else}}
                                        <span class="nd5t-badge world" title="This setting applies to all users in this world">World</span>
                                        {{/if}}

                                        {{#if this.v14Only}}
                                        <span class="nd5t-badge v14" title="This feature requires Foundry V14 or higher">V14+</span>
                                        {{/if}}

                                        {{#if this.requiresReload}}
                                        <span class="nd5t-badge reload" title="Changing this setting requires reloading the world">Reload</span>
                                        {{/if}}
                                    </div>
                                </div>
                                
                                {{#if this.hint}}
                                <p class="nd5t-setting-hint">{{this.hint}}</p>
                                {{/if}}
                            </div>

                            <div class="nd5t-setting-control">
                                {{#if (eq this.type "Boolean")}}
                                <label class="nd5t-switch">
                                    <input type="checkbox" id="nd5t-setting-{{this.key}}" name="{{this.key}}" {{#if this.value}}checked{{/if}} {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                    <span class="nd5t-slider"></span>
                                </label>
                                {{else if (eq this.type "Select")}}
                                <select id="nd5t-setting-{{this.key}}" name="{{this.key}}" class="nd5t-select" {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                    {{#each this.choices}}
                                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                                {{else if (eq this.type "Number")}}
                                <input type="number" id="nd5t-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nd5t-number-input" {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                {{else if (eq this.type "FilePicker")}}
                                <div class="nd5t-file-picker-group">
                                    <input type="text" id="nd5t-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nd5t-text-input" {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                    <button type="button" class="nd5t-file-picker-btn" data-target="nd5t-setting-{{this.key}}" data-type="{{this.filePicker}}" title="Browse Files" {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                        <i class="fa-solid fa-file-import"></i>
                                    </button>
                                </div>
                                {{else}}
                                <input type="text" id="nd5t-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nd5t-text-input" {{#unless @root.canModify}}{{#unless this.isClient}}{{#unless this.isUser}}disabled{{/unless}}{{/unless}}{{/unless}}>
                                {{/if}}
                            </div>

                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </section>
            {{/each}}

            <div class="nd5t-no-results" style="display: none;">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                <p>No tweaks or settings match your search query.</p>
                <button type="button" class="nd5t-btn-clear-search">Clear Search</button>
            </div>
        </div>
    </div>

    {{!-- Footer Bar --}}
    <footer class="nd5t-dashboard-footer">
        <div class="nd5t-footer-left">
            <button type="button" class="nd5t-btn secondary" data-action="resetDefaults" {{#unless canModify}}disabled{{/unless}} title="Reset all settings to default values">
                <i class="fa-solid fa-rotate-left"></i> Reset Defaults
            </button>
            <button type="button" class="nd5t-btn secondary" data-action="exportSettings" title="Export all settings to a JSON file">
                <i class="fa-solid fa-download"></i> Export JSON
            </button>
            <button type="button" class="nd5t-btn secondary" data-action="importSettings" {{#unless canModify}}disabled{{/unless}} title="Import settings from a JSON file">
                <i class="fa-solid fa-upload"></i> Import JSON
            </button>
            <input type="file" class="nd5t-file-import-input" accept=".json" style="display: none;">
        </div>
        <div class="nd5t-footer-right">
            <button type="button" class="nd5t-btn cancel" data-action="close" title="Cancel without saving">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button type="submit" class="nd5t-btn primary" title="Save changes">
                <i class="fa-solid fa-floppy-disk"></i> Save Changes
            </button>
        </div>
    </footer>
</div>
